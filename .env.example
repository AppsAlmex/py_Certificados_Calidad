# Credenciales del servicio Oracle BI Publisher.
# Copiar a .env y rellenar. NUNCA versionar .env con credenciales reales.
CERT_USER=appsalmex2
CERT_PASSWORD=cambia_esto

# Timeout en segundos por solicitud (sobrescribe config.ini).
CERT_TIMEOUT=300

# Reporte a consumir: clave definida en [reports] de config.ini.
CERT_REPORT=certificado_calidad
