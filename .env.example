# Credenciales del servicio Oracle BI Publisher.
# Copiar a .env y rellenar. NUNCA versionar .env con credenciales reales.
CERT_USER=appsalmex2
CERT_PASSWORD=cambia_esto

# Read timeout en segundos por solicitud (sobrescribe config.ini).
# Reportes largos (hasta ~70 min) requieren un valor alto, ej. 5400.
CERT_TIMEOUT=300

# Connect timeout en segundos (abrir conexion). Corto a proposito.
CERT_CONNECT_TIMEOUT=30

# Hilos concurrentes: 1 = secuencial (default). >1 = peticiones en paralelo.
CERT_WORKERS=1

# Reporte a consumir: clave definida en [reports] de config.ini.
CERT_REPORT=certificado_calidad
